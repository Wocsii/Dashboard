# ─────────────────────────────────────────────────────────────
# Copia este archivo a `.env.local` (local) y define las mismas
# variables en Vercel → Project → Settings → Environment Variables.
# NUNCA subas `.env.local` a Git.
# Sin las variables de Supabase la app arranca en MODO DEMO.
# ─────────────────────────────────────────────────────────────

# ── Frontend (públicas: se incrustan en el JS, son seguras gracias a RLS) ──
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ── Servidor (solo funciones /api, nunca con prefijo VITE_) ──
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Google Calendar (opcional: si faltan, el calendario muestra "sin configurar")
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Debe coincidir EXACTAMENTE con una URI autorizada en Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback

# 32 bytes en base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# URL pública de la app (a dónde vuelve el usuario tras conectar Google)
APP_URL=http://localhost:5173
